[Unit]
Description=LLM provider router backend (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/hevin/Developer/tools/llm-provider-router
# vault-generated merged env（含 AGENT_AI_ARK_* provider keys 及全部密钥）；
# 由 secret-vault restore（opencode-env-conf entry）重新生成。
# 历史：曾拆分为 ~/.config/opencode/agent-{secrets,internal,config}.env，
# 该目录已废弃；env 统一合并到 agent-env.conf，勿再引用已删除文件，
# 否则 systemd EnvironmentFile 加载失败会直接拒绝 spawn（2026-10-02 blue 槽事故）。
EnvironmentFile=/home/hevin/.config/environment.d/agent-env.conf
Environment=LLM_PROVIDER_ROUTER_HOST=127.0.0.1
# runtime reload-env: /api/config/reload-env re-reads this file without restart
Environment=LLM_PROVIDER_ROUTER_ENV_FILE=/home/hevin/.config/environment.d/agent-env.conf
Environment=SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
Environment=SSL_CERT_DIR=/etc/ssl/certs
ExecSearchPath=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/bin/sh -lc 'case "%i" in blue) export LLM_PROVIDER_ROUTER_PORT=8790 ;; green) export LLM_PROVIDER_ROUTER_PORT=8791 ;; *) echo "unknown slot: %i" >&2; exit 2 ;; esac; exec /home/hevin/Developer/tools/llm-provider-router/target/release/llm-provider-router backend'
Restart=on-failure
RestartSec=3
TimeoutStartSec=60
KillSignal=SIGTERM
SuccessExitStatus=143

[Install]
WantedBy=default.target
